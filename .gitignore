.venv/
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/

# P4.5 generated data and model weights; keep manifests and reports tracked.
artifacts/cc_nqe_p4_5/checkpoints/
artifacts/cc_nqe_p4_5/datasets/**/*.npy
artifacts/cc_nqe_p4_5/datasets/**/*.npz
artifacts/cc_nqe_p4_5/datasets/**/*.bin

# CC-NQE generated dataset payloads
artifacts/cc_nqe_p4_5/datasets/circuits.jsonl
artifacts/cc_nqe_p4_5/datasets/states.jsonl

# CC-NQE P4.6 generated dataset payloads
artifacts/cc_nqe_p4_6/datasets/**/*.npy
artifacts/cc_nqe_p4_6/datasets/**/*.npz
artifacts/cc_nqe_p4_6/checkpoints/
artifacts/cc_nqe_p4_6/track_a/
artifacts/cc_nqe_p4_6/track_a_terminal.log
artifacts/cc_nqe_p4_6/operator/checkpoints/
artifacts/cc_nqe_p4_6/operator/data/

# P4.7 scientific checkpoints and live status are local runtime payloads.
artifacts/cc_nqe_p4_7/checkpoints/
artifacts/cc_nqe_p4_7/progress.jsonl
artifacts/cc_nqe_p4_7/status.json
artifacts/cc_nqe_p4_7/confirmatory/checkpoints/
artifacts/cc_nqe_p4_7/confirmatory/progress.jsonl
artifacts/cc_nqe_p4_7/confirmatory/status.json

# P4.8 transaction-private per-example results are never public artifacts.
artifacts/cc_nqe_p4_8/.transaction-*/

# R2 generated teacher payloads, checkpoints, and expanded manifests stay local.
artifacts/r2_amortized_backend/**/*.npz
artifacts/r2_amortized_backend/**/*.pt
artifacts/r2_amortized_backend/**/*_manifest*.json
artifacts/r2_amortized_backend/**/.worker/
